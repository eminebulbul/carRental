@page
@model CarRental.Pages.DamageReports.IndexModel
@{
    ViewData["Title"] = "Hasar Raporları";
}

<h1>🔥 Hasar Raporları</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Rapor ID, kiralama ID, hasar açıklaması ile ara..." value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-outline-primary btn-sm">🔍 Ara</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="/DamageReports/Index" class="btn btn-outline-secondary btn-sm">✖️ Temizle</a>
            }
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        @if (Model.FilterRentalId.HasValue)
        {
            <span class="badge bg-info">Kiralama #@Model.FilterRentalId Filtrelenmiş</span>
            <a asp-page="/DamageReports/Index" class="btn btn-sm btn-outline-secondary ms-2">Filtreyi Kaldır</a>
        }
    </div>
    <a asp-page="/DamageReports/Create" class="btn btn-primary btn-sm">+ Yeni Rapor</a>
</div>

@if (Model.DamageReports.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Rapor ID</th>
                    <th>Kiralama ID</th>
                    <th>Hasar Açıklaması</th>
                    <th>Tamir Maliyeti</th>
                    <th>Rapor Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.DamageReports)
                {
                    <tr>
                        <td>@report.DamageId</td>
                        <td><a asp-page="/Rentals/Index" asp-route-id="@report.RentalId">#@report.RentalId</a></td>
                        <td>@report.Description</td>
                        <td>@(report.RepairCost?.ToString("C") ?? "-")</td>
                        <td>@(report.ReportDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            <a asp-page="/DamageReports/Edit" asp-route-id="@report.DamageId" class="btn btn-warning btn-sm">Düzenle</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@report.DamageId" style="display:inline;" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        @if (Model.FilterRentalId.HasValue)
        {
            <text>Bu kiralama için henüz hasar raporu yoktur.</text>
        }
        else
        {
            <text>Henüz hasar raporu yoktur.</text>
        }
    </div>
}

<a asp-page="/Vehicles/Index" class="btn btn-secondary mt-4">Araçlar</a>
