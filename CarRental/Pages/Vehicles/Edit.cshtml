@page "{id:int}"
@model CarRental.Pages.Vehicles.EditModel
@{
    ViewData["Title"] = "Araç Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form method="post">
                <input asp-for="Vehicle.VehicleId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Vehicle.PlateNumber" class="form-label"></label>
                    <input asp-for="Vehicle.PlateNumber" class="form-control" />
                    <span asp-validation-for="Vehicle.PlateNumber" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Vehicle.Brand" class="form-label"></label>
                        <input asp-for="Vehicle.Brand" class="form-control" />
                        <span asp-validation-for="Vehicle.Brand" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Vehicle.Model" class="form-label"></label>
                        <input asp-for="Vehicle.Model" class="form-control" />
                        <span asp-validation-for="Vehicle.Model" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Vehicle.Year" class="form-label"></label>
                        <input asp-for="Vehicle.Year" class="form-control" />
                        <span asp-validation-for="Vehicle.Year" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Vehicle.DailyPrice" class="form-label"></label>
                        <input asp-for="Vehicle.DailyPrice" class="form-control" />
                        <span asp-validation-for="Vehicle.DailyPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Vehicle.Mileage" class="form-label"></label>
                        <input asp-for="Vehicle.Mileage" class="form-control" />
                        <span asp-validation-for="Vehicle.Mileage" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Vehicle.CategoryId" class="form-label">Kategori</label>
                        <select asp-for="Vehicle.CategoryId" asp-items="Model.CategorySelectList" class="form-select">
                            <option value="">-- Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="Vehicle.CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Vehicle.BranchId" class="form-label">Şube</label>
                        <select asp-for="Vehicle.BranchId" asp-items="Model.BranchSelectList" class="form-select">
                            <option value="">-- Şube Seçin --</option>
                        </select>
                        <span asp-validation-for="Vehicle.BranchId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Vehicle.Status" class="form-label"></label>
                    <select asp-for="Vehicle.Status" asp-items="Model.StatusSelectList" class="form-select">
                        <option value="">-- Durum Seçin --</option>
                    </select>
                    <span asp-validation-for="Vehicle.Status" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-page="/Vehicles/ManageFeatures" asp-route-id="@Model.Vehicle.VehicleId" class="btn btn-info">Özellikleri Yönet</a>
                    <a asp-page="/Vehicles/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
