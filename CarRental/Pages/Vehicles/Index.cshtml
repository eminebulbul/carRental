@page
@model CarRental.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Araç Listesi";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="display-5">🚗 Araç Listesi</h1>
        </div>
        <div class="col-md-6 text-end">
            <a class="btn btn-primary me-2" asp-page="/Vehicles/Create">Yeni Ekle</a>
            <span class="badge bg-success fs-6">Toplam: @Model.Vehicles.Count() araç</span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Plaka, marka, model veya ID ile ara..." value="@Model.SearchTerm" />
                <button type="submit" class="btn btn-outline-primary btn-sm">🔍 Ara</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Vehicles/Index" class="btn btn-outline-secondary btn-sm">✖️ Temizle</a>
                }
            </form>
        </div>
    </div>

    @if (Model.Vehicles.Any())
    {
        <div class="row">
            @foreach (var vehicle in Model.Vehicles)
            {
                var statusClass = vehicle.Status switch
                {
                    "available" => "status-available",
                    "rented" => "status-rented",
                    "maintenance" => "status-maintenance",
                    _ => "badge-secondary"
                };

                var statusText = vehicle.Status switch
                {
                    "available" => "Uygun",
                    "rented" => "Kiralanmış",
                    "maintenance" => "Bakımda",
                    _ => vehicle.Status
                };

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title">@vehicle.Brand @vehicle.Model</h5>
                                    <p class="text-muted mb-0"><small>Plaka: <code>@vehicle.PlateNumber</code></small></p>
                                </div>
                                <span class="badge @statusClass">@statusText</span>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted d-block">
                                    📅 Yıl: <strong>@vehicle.Year</strong>
                                </small>
                                <small class="text-muted d-block">
                                    📏 KM: <strong>@vehicle.Mileage</strong>
                                </small>
                                <small class="text-muted d-block">
                                    💰 Günlük: <strong>₺@vehicle.DailyPrice</strong>
                                </small>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <a asp-page="/Vehicles/ManageFeatures" asp-route-id="@vehicle.VehicleId" class="btn btn-sm btn-outline-info">Özellikler</a>
                                <a asp-page="/DamageReports/Index" class="btn btn-sm btn-outline-danger">Hasar Raporları</a>
                                <a asp-page="/Vehicles/Edit" asp-route-id="@vehicle.VehicleId" class="btn btn-sm btn-outline-warning">Düzenle</a>
                                <a asp-page="/Vehicles/Delete" asp-route-id="@vehicle.VehicleId" class="btn btn-sm btn-outline-danger">Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p class="mb-0">😕 Henüz araç kaydı yok.</p>
        </div>
    }
</div>
