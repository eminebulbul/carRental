@page "{id:int}"
@model CarRental.Pages.Vehicles.DeleteModel
@{
    ViewData["Title"] = "Araç Sil";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <div class="alert alert-danger">
                <p>Bu aracı silmek istediğinizden emin misiniz?</p>
                <p><strong>@Model.Vehicle?.Brand @Model.Vehicle?.Model</strong> — Plaka: <code>@Model.Vehicle?.PlateNumber</code></p>
            </div>

            <form method="post">
                <input asp-for="Vehicle.VehicleId" type="hidden" />
                <button type="submit" class="btn btn-danger">Sil</button>
                <a asp-page="/Vehicles/Index" class="btn btn-secondary ms-2">İptal</a>
            </form>
        </div>
    </div>
</div>
