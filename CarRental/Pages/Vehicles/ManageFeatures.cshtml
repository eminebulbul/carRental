@page "{id:int}"
@model CarRental.Pages.Vehicles.ManageFeaturesModel
@{
    ViewData["Title"] = "Araç Özellikleri";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h1 class="mb-1">Araç Özellikleri</h1>
                    <p class="text-muted mb-0">
                        @Model.Vehicle?.Brand @Model.Vehicle?.Model - @Model.Vehicle?.PlateNumber
                    </p>
                </div>
                <a asp-page="/Vehicles/Index" class="btn btn-outline-secondary">Geri Dön</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (Model.AvailableFeatures.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                Tanımlı özellik bulunamadı.
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var feature in Model.AvailableFeatures)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100 bg-light">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedFeatureIds"
                                                       value="@feature.FeatureId"
                                                       id="feature_@feature.FeatureId"
                                                       @Html.Raw(feature.IsSelected ? "checked=\"checked\"" : string.Empty) />
                                                <label class="form-check-label fw-semibold" for="feature_@feature.FeatureId">
                                                    @feature.Name
                                                </label>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(feature.Description))
                                            {
                                                <div class="small text-muted mt-2">
                                                    @feature.Description
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            <a asp-page="/Vehicles/Index" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
