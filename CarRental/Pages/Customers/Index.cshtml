@page
@model CarRental.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">📋 Müşteri Listesi</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Create" class="btn btn-success btn-sm me-2">➕ Yeni Müşteri</a>
            <span class="badge bg-info fs-6">Toplam: @Model.Customers.Count() müşteri</span>
        </div>
    </div>

    @if (Model.Customers.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%">ID</th>
                        <th style="width: 25%">Ad Soyad</th>
                        <th style="width: 20%">Ehliyet</th>
                        <th style="width: 20%">E-posta</th>
                        <th style="width: 12%">Telefon</th>
                        <th style="width: 8%">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><strong>@customer.CustomerId</strong></td>
                            <td>@customer.FirstName @customer.LastName</td>
                            <td><code>@customer.LicenseNumber</code></td>
                            <td><a href="mailto:@customer.Email">@customer.Email</a></td>
                            <td><a href="tel:@customer.Phone">@customer.Phone</a></td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@customer.CustomerId" class="btn btn-warning btn-sm">✏️</a>
                                <a asp-page="./Delete" asp-route-id="@customer.CustomerId" class="btn btn-danger btn-sm">🗑️</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p class="mb-0">😕 Henüz müşteri kaydı yok.</p>
        </div>
    }
</div>
