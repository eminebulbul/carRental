@page "{id:int}"
@model CarRental.Pages.Branches.EditBranchModel
@{
    ViewData["Title"] = "Şube Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form method="post">
                <input asp-for="Branch.BranchId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Branch.City" class="form-label"></label>
                    <input asp-for="Branch.City" class="form-control" />
                    <span asp-validation-for="Branch.City" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Branch.Address" class="form-label"></label>
                    <textarea asp-for="Branch.Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Branch.Address" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Branch.Phone" class="form-label"></label>
                    <input asp-for="Branch.Phone" class="form-control" />
                    <span asp-validation-for="Branch.Phone" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-page="/Branches/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
