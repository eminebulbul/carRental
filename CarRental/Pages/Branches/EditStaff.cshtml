@page "{id:int}"
@model CarRental.Pages.Branches.EditStaffModel
@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form method="post">
                <input asp-for="Staff.StaffId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Staff.FirstName" class="form-label"></label>
                        <input asp-for="Staff.FirstName" class="form-control" />
                        <span asp-validation-for="Staff.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Staff.LastName" class="form-label"></label>
                        <input asp-for="Staff.LastName" class="form-control" />
                        <span asp-validation-for="Staff.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Staff.Role" class="form-label"></label>
                        <input asp-for="Staff.Role" class="form-control" />
                        <span asp-validation-for="Staff.Role" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Staff.BranchId" class="form-label">Şube</label>
                        <select asp-for="Staff.BranchId" asp-items="Model.BranchSelectList" class="form-select">
                            <option value="">-- Şube Seçin --</option>
                        </select>
                        <span asp-validation-for="Staff.BranchId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-page="/Branches/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
