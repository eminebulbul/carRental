@page
@model CarRental.Pages.Payments.IndexModel

@{
    ViewData["Title"] = "Ödemeler";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Ödemeler</h2>
        <p class="text-muted mb-0">Sistemdeki tüm ödeme işlemlerini yönetin ve takip edin.</p>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-primary">
            + Yeni Ödeme
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>Kiralama No</th>
                        <th>Müşteri</th>
                        <th>Tutar</th>
                        <th>Yöntem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Payments)
                    {
                        <tr>
                            <td>
                                @if (item.PaymentDate.HasValue)
                                {
                                    @item.PaymentDate.Value.ToString("dd.MM.yyyy HH:mm")
                                }
                            </td>
                            <td>
                                <span class="text-primary fw-medium">
                                    #@item.RentalId
                                </span>
                            </td>
                            <td>
                                @if (item.Rental?.Customer != null)
                                {
                                    @($"{item.Rental.Customer.FirstName} {item.Rental.Customer.LastName}")
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-success">₺@item.Amount.ToString("N2")</span>
                            </td>
                            <td>
                                @if (item.Method == "credit_card")
                                {
                                    <span class="badge bg-primary">💳 Kredi Kartı</span>
                                }
                                else if (item.Method == "cash")
                                {
                                    <span class="badge bg-success">💵 Nakit</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Method</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Payments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Henüz herhangi bir ödeme kaydı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
