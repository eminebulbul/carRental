@page
@model CarRental.Pages.Reports.QueriesModel
@{
    ViewData["Title"] = "Raporlar ve SQL Sorguları";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Raporlar / SQL Sorguları</h2>
        <p class="text-muted mb-0">Hazır sorguları tek tıkla çalıştırıp sonuçları tabloda görüntüleyin.</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Hazır Sorgular</h5>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var query in Model.QueryDefinitions)
            {
                var isSelected = query.Key == Model.SelectedQueryKey;
                <form method="post" asp-page-handler="Run">
                    <button type="submit"
                            name="queryKey"
                            value="@query.Key"
                            class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") btn-sm">
                        @query.Title
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Kendi SQL Sorgun</h5>
        <p class="text-muted mb-3">Sadece okuma sorgulari (SELECT veya WITH) calistirilir. Sonuc en fazla 500 satirla sinirlandirilir.</p>

        <form method="post" asp-page-handler="RunCustom">
            <div class="mb-3">
                <textarea asp-for="CustomSql" class="form-control" rows="8" placeholder="Ornek: SELECT * FROM vehicle WHERE status = 'available' ORDER BY daily_price;"></textarea>
            </div>

            <button type="submit" class="btn btn-success">Sorguyu Çalıştır</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.CustomQueryError))
        {
            <div class="alert alert-danger mt-3 mb-0">@Model.CustomQueryError</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.SelectedQueryTitle</h5>
        <p class="text-muted">@Model.SelectedQueryDescription</p>
        <pre class="bg-light p-3 rounded border"><code>@Model.SelectedSql</code></pre>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-3">Sorgu Sonucu</h5>

        @if (Model.ResultColumns.Count == 0)
        {
            <div class="alert alert-warning mb-0">Sütun bilgisi bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            @foreach (var column in Model.ResultColumns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResultRows.Count == 0)
                        {
                            <tr>
                                <td colspan="@Model.ResultColumns.Count" class="text-center text-muted py-4">
                                    Kayıt bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.ResultRows)
                            {
                                <tr>
                                    @foreach (var value in row)
                                    {
                                        <td>@value</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
