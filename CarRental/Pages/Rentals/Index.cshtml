@page
@model CarRental.Pages.Rentals.IndexModel
@{
    ViewData["Title"] = "Kiralamalar";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">🔄 Kiralamalar</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Create" class="btn btn-success btn-sm me-2">➕ Yeni Kiralama</a>
            <span class="badge bg-info fs-6">Toplam: @Model.Rentals.Count() kiralama</span>
        </div>
    </div>

    @if (Model.Rentals.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%">ID</th>
                        <th style="width: 15%">Müşteri</th>
                        <th style="width: 15%">Araç</th>
                        <th style="width: 12%">Başlangıç</th>
                        <th style="width: 12%">Bitiş</th>
                        <th style="width: 12%">Toplam</th>
                        <th style="width: 10%">Durum</th>
                        <th style="width: 8%">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model.Rentals)
                    {
                        var statusClass = rental.Status switch
                        {
                            "pending" => "badge-info",
                            "active" => "badge-success",
                            "completed" => "badge-secondary",
                            "cancelled" => "badge-danger",
                            _ => "badge-secondary"
                        };

                        var statusText = rental.Status switch
                        {
                            "pending" => "Beklemede",
                            "active" => "Aktif",
                            "completed" => "Tamamlandi",
                            "cancelled" => "İptal",
                            _ => rental.Status
                        };

                        <tr>
                            <td><strong>@rental.RentalId</strong></td>
                            <td>
                                @if (rental.Customer != null)
                                {
                                    <span>@rental.Customer.FirstName @rental.Customer.LastName</span>
                                }
                            </td>
                            <td>
                                @if (rental.Vehicle != null)
                                {
                                    <span>@rental.Vehicle.Brand @rental.Vehicle.Model</span>
                                }
                            </td>
                            <td><small>@rental.StartDate.ToString("dd/MM/yyyy")</small></td>
                            <td>
                                <small>
                                    @if (rental.EndDate.HasValue)
                                    {
                                        @rental.EndDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </small>
                            </td>
                            <td><strong>₺@rental.TotalAmount</strong></td>
                            <td><span class="badge @statusClass">@statusText</span></td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@rental.RentalId" class="btn btn-warning btn-sm">✏️</a>
                                <a asp-page="./Delete" asp-route-id="@rental.RentalId" class="btn btn-danger btn-sm">🗑️</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <p class="mb-0">😕 Henüz kiralama kaydı yok.</p>
        </div>
    }
</div>
